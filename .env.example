NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://wa:wa@localhost:5432/wa
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_SECONDS=3600
WORKER_ID=wa-worker-local-1
SESSION_LEASE_MS=45000
SESSION_COMMAND_POLL_MS=1000
SESSION_RECOVERY_BATCH_SIZE=25
SESSION_CONNECTING_STALE_MS=90000
SESSION_RECOVERY_WATCHDOG_MS=30000
WA_AUTH_DIR=.data/wa-auth
WA_LOG_LEVEL=silent
MEDIA_FETCH_TIMEOUT_MS=20000
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
MESSAGE_QUEUE_CONCURRENCY=10
MESSAGE_QUEUE_PUMP_MS=1000
MESSAGE_QUEUE_PUMP_BATCH=100
MESSAGE_RETRY_BASE_MS=5000
MESSAGE_RATE_LIMIT_MAX=20
MESSAGE_RATE_LIMIT_WINDOW_MS=10000
MESSAGE_GLOBAL_RATE_LIMIT_MAX=100
MESSAGE_GLOBAL_RATE_LIMIT_WINDOW_MS=1000
TRIAL_DAYS=7
# Defaults to test. Live Stripe requires STRIPE_MODE=live plus matching live credentials.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=https://relaywa.com/subscription
STRIPE_SUCCESS_URL=https://relaywa.com/subscription?checkout=success
STRIPE_CANCEL_URL=https://relaywa.com/subscription?checkout=cancel
# Development uses the API port directly. Production: https://relaywa.com/api\nNEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
RELAYWA_ADMIN_EMAIL=
RELAYWA_ADMIN_PASSWORD=
RELAYWA_ADMIN_NAME=relayWA Administrator
RELAYWA_ADMIN_ORG=relayWA Platform
# Production single-origin deployment: https://relaywa.com\nCORS_ORIGINS=http://localhost:3000
BACKUP_DIR=./backups
POSTGRES_DB=relaywa
POSTGRES_USER=relaywa
POSTGRES_PASSWORD=

# Google Identity Services (same OAuth Web client ID in API and web build)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# RelayWA Platform Admin: GA4 reporting (API service only).
# Service account must have GA4 Viewer access to property 558119248.
# Mount a restricted credential JSON file into the API container; NEVER commit it.
# Leave blank until the secret file is provisioned, and don't use NEXT_PUBLIC_.
GA4_SERVICE_ACCOUNT_FILE=

# GitHub OAuth App (tenant signup/login only; keep the secret server-side)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://relaywa.com/api/auth/github/callback
AUTH_FRONTEND_URL=https://relaywa.com

# Messaging engines
WA_CHROMIUM_AUTH_DIR=.data/wa-chromium-auth
# Optional. Leave blank to use Puppeteer's bundled Chromium.
CHROMIUM_EXECUTABLE_PATH=
# Chromium is much heavier than Baileys, so cap browser sessions per worker.
CHROMIUM_MAX_SESSIONS_PER_WORKER=6


# Operational email alerts
# Alerts are queued in PostgreSQL and delivered by the worker. If SMTP is not
# configured, queued alerts remain available until mail delivery is configured.
ALERT_EMAIL_ENABLED=true
# Optional comma-separated override. When blank, active platform-admin emails are used.
ALERT_EMAIL_TO=
ALERT_RECONNECT_THRESHOLD=3
ALERT_DEDUPE_SECONDS=900
ALERT_EMAIL_MAX_ATTEMPTS=6
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Local checkout simulator. Always blocked when NODE_ENV=production.
DEMO_PAYMENTS_ENABLED=false

# Public canonical origin for SEO, sitemap and social sharing.
NEXT_PUBLIC_SITE_URL=https://relaywa.com

# Immediate API -> session worker dispatch (private network only).
WORKER_DISPATCH_URL=http://127.0.0.1:3002
WORKER_DISPATCH_HOST=127.0.0.1
WORKER_DISPATCH_PORT=3002
# Optional dedicated shared secret; falls back to JWT_SECRET in API and worker.
WORKER_DISPATCH_SECRET=
# Optional JSON object mapping WORKER_ID values to internal worker URLs.
WORKER_DISPATCH_URLS={}
