NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
DATABASE_URL=postgresql://wa:wa@localhost:5432/wa
DB_POOL_MAX=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_SECONDS=3600
WORKER_ID=wa-worker-local-1
SESSION_LEASE_MS=45000
SESSION_COMMAND_POLL_MS=1000
SESSION_RECOVERY_BATCH_SIZE=25
SESSION_CONNECTING_STALE_MS=90000
SESSION_RECOVERY_WATCHDOG_MS=30000
WA_AUTH_DIR=.data/wa-auth
WA_LOG_LEVEL=silent
MEDIA_FETCH_TIMEOUT_MS=20000
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
MESSAGE_QUEUE_CONCURRENCY=10
MESSAGE_QUEUE_PUMP_MS=1000
MESSAGE_QUEUE_PUMP_BATCH=100
MESSAGE_RETRY_BASE_MS=5000
MESSAGE_RATE_LIMIT_MAX=20
MESSAGE_RATE_LIMIT_WINDOW_MS=10000
MESSAGE_GLOBAL_RATE_LIMIT_MAX=100
MESSAGE_GLOBAL_RATE_LIMIT_WINDOW_MS=1000
TRIAL_DAYS=7
STRIPE_SECRET_KEY=\nSTRIPE_WEBHOOK_SECRET=\nSTRIPE_SUCCESS_URL=https://relaywa.example/billing/success\nSTRIPE_CANCEL_URL=https://relaywa.example/billing/cancel\n