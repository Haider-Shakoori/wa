{
  "name": "businessos-wa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --parallel --filter @wa/api --filter @wa/web --filter @wa/worker dev",
    "smoke": "node scripts/smoke.mjs",
    "load:smoke": "node scripts/load-smoke.mjs",
    "canary:prod": "node scripts/production-canary.mjs",
    "validate:prod-compose": "docker compose -f docker-compose.production.yml config --quiet"
  }
}
